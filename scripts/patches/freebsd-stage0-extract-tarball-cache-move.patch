 const ExtractTarball = @This();
 
+fn moveDirTreeSlowMaybe(from_parent: std.fs.Dir, from_rel_z: [:0]const u8, to_parent: std.fs.Dir, to_rel_z: [:0]const u8) !void {
+    const from_rel = bun.span(from_rel_z);
+    const to_rel = bun.span(to_rel_z);
+
+    // FreeBSD stage0 bootstrap fallback: package cache entries are directories.
+    // `moveFileZSlowMaybe()` is file-only and fails with EISDIR for package trees.
+    // Copy the directory tree and then delete the source directory.
+    try to_parent.makePath(to_rel);
+
+    var src_dir = try from_parent.openDir(from_rel, .{ .iterate = true });
+    defer src_dir.close();
+
+    var dst_dir = try to_parent.openDir(to_rel, .{});
+    defer dst_dir.close();
+
+    var walker = try src_dir.walk(default_allocator);
+    defer walker.deinit();
+
+    var link_buf: [bun.MAX_PATH_BYTES]u8 = undefined;
+
+    while (try walker.next()) |entry| {
+        switch (entry.kind) {
+            .directory => try dst_dir.makePath(bun.span(entry.path)),
+            .file => try src_dir.copyFile(bun.span(entry.path), dst_dir, bun.span(entry.path), .{}),
+            .sym_link => {
+                const target = try entry.dir.readLink(bun.span(entry.basename), &link_buf);
+                try dst_dir.symLink(target, bun.span(entry.path), .{});
+            },
+            else => {},
+        }
+    }
+
+    try from_parent.deleteTree(from_rel);
+}
