+static bool submit_kevent_change(int kq, struct kevent* change)
+{
+    struct kevent out;
+    struct timespec timeout = { 0, 0 };
+
+    while (true) {
+        const int rc = kevent(kq, change, 1, &out, 1, &timeout);
+        if (rc == -1) {
